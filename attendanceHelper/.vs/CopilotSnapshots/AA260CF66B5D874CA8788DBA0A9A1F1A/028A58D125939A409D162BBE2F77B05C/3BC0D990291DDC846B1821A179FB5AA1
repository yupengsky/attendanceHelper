<Window x:Class="attendanceHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:attendanceHelper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- 标题 -->
        <TextBlock Text="随机考勤小工具-计原25" FontSize="40" FontWeight="Bold" HorizontalAlignment="Left" Margin="60,50,0,0" VerticalAlignment="Top"/>
        
        <!-- 邀请码输入 -->
        <TextBlock Text="输入邀请码:" FontSize="16" HorizontalAlignment="Left" Margin="80,130,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="InviteCodeTextBox" Text="Code Here" Width="220" Height="28" HorizontalAlignment="Left" Margin="180,125,0,0" VerticalAlignment="Top"/>
        
        <!-- 密码输入 -->
        <TextBlock Text="密码:" FontSize="16" HorizontalAlignment="Left" Margin="120,170,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="PasswordTextBox" Text="Code Here" Width="220" Height="28" HorizontalAlignment="Left" Margin="180,165,0,0" VerticalAlignment="Top"/>
        <Button Content="确认密码" Width="100" Height="28" HorizontalAlignment="Left" Margin="420,165,0,0" VerticalAlignment="Top"/>
        
        <!-- 四个主要操作按钮 -->
        <Button Content="导入名单" Width="120" Height="48" HorizontalAlignment="Left" Margin="80,250,0,0" VerticalAlignment="Top"/>
        <Button Content="查看考勤情况" Width="120" Height="48" HorizontalAlignment="Left" Margin="260,250,0,0" VerticalAlignment="Top"/>
        <Button Content="导出名单" Width="120" Height="48" HorizontalAlignment="Left" Margin="440,250,0,0" VerticalAlignment="Top"/>
        <Button Content="开始考勤" Width="120" Height="48" HorizontalAlignment="Left" Margin="620,250,0,0" VerticalAlignment="Top"/>
        
        <!-- 作者信息和链接 -->
        <TextBlock Text="ByYupeng" FontSize="14" HorizontalAlignment="Left" Margin="80,380,0,0" VerticalAlignment="Top"/>
        <TextBlock Text="https://github.com/yupengsky/randomAttendance" FontSize="12" HorizontalAlignment="Left" Margin="80,400,0,0" VerticalAlignment="Top"/>
        
        <!-- 右下角未注册 -->
        <TextBlock Text="未注册" FontSize="14" HorizontalAlignment="Right" Margin="0,0,40,20" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
