<Window x:Class="attendanceHelper.HelloTeacher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:attendanceHelper"
        mc:Ignorable="d"
        Title="HelloTeacher" Height="450" Width="800">
    <Grid>
        <!-- 说明文本 -->
        <TextBlock Text="输入密码，完成注册。" FontSize="18" Margin="60,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        
        <!-- 注册密码输入 -->
        <TextBlock Text="注册密码" FontSize="16" Margin="120,120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox x:Name="RegisterPasswordTextBox" Text="Code Here" Width="350" Height="32" Margin="220,115,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        
        <!-- 两个按钮 -->
        <Button x:Name="ok" Content="确认" Width="80" Height="32" Margin="160,200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ok_Click"/>
        <Button x:Name="okok" Content="二次确认" Width="100" Height="32" Margin="270,200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="okok_Click"/>
    </Grid>
</Window>
