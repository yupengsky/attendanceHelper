using System;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Media;

namespace attendanceHelper
{
    public partial class HelloTeacher : Window
    {
        public HelloTeacher()
        {
            InitializeComponent();
            // 初始设置okok按钮为浅色且不可用
            okok.IsEnabled = false;
            okok.Background = new SolidColorBrush(Color.FromRgb(230, 230, 230)); // 很浅的灰色
        }

        private void ok_Click(object sender, RoutedEventArgs e)
        {
            // okok按钮变为正常颜色并可用
            okok.IsEnabled = true;
            okok.Background = ok.Background;
        }

        private void okok_Click(object sender, RoutedEventArgs e)
        {
            // 设置全局变量
            App.GlobalCode = RegisterPasswordTextBox.Text;
            // 修改MainWindow的stateText
            foreach (Window win in Application.Current.Windows)
            {
                if (win is MainWindow mainWin)
                {
                    mainWin.stateText.Text = "已注册";
                }
            }
            // 关闭当前窗口
            this.Close();
        }
    }
}
