<Window x:Class="attendanceHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:attendanceHelper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- 标题 -->
        <TextBlock Text="随机考勤小工具-计原25" FontSize="40" FontWeight="Bold" HorizontalAlignment="Left" Margin="60,50,0,0" VerticalAlignment="Top"/>

        <!-- 密码输入 -->
        <TextBlock Text="密码:" FontSize="16" HorizontalAlignment="Left" Margin="119,190,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="PasswordTextBox" Text="Code Here" Width="220" Height="28" HorizontalAlignment="Left" Margin="179,185,0,0" VerticalAlignment="Top"/>
        <Button x:Name="isOK" Content="确认密码" Width="100" Height="28" HorizontalAlignment="Left" Margin="419,185,0,0" VerticalAlignment="Top" Click="isOK_Click_1"/>

        <!-- GlobalCode显示 -->
        <TextBlock x:Name="GlobalCodeHere" FontSize="16" HorizontalAlignment="Left" Margin="179,220,0,0" VerticalAlignment="Top" Width="326" Text=""/>

        <!-- 四个主要操作按钮 -->
        <Button x:Name="导入名单" Content="导入名单" Width="120" Height="48" HorizontalAlignment="Left" Margin="79,270,0,0" VerticalAlignment="Top"/>
        <Button x:Name="查看考勤情况" Content="查看考勤情况" Width="120" Height="48" HorizontalAlignment="Left" Margin="259,270,0,0" VerticalAlignment="Top"/>
        <Button x:Name="导出名单" Content="导出名单" Width="120" Height="48" HorizontalAlignment="Left" Margin="439,270,0,0" VerticalAlignment="Top"/>
        <Button x:Name="开始考勤" Content="开始考勤" Width="120" Height="48" HorizontalAlignment="Left" Margin="619,270,0,0" VerticalAlignment="Top"/>

        <!-- 作者信息和链接 -->
        <TextBlock Text="ByYupeng" FontSize="14" HorizontalAlignment="Left" Margin="80,380,0,0" VerticalAlignment="Top"/>
        <TextBlock Text="https://github.com/yupengsky/randomAttendance" FontSize="12" HorizontalAlignment="Left" Margin="80,400,0,0" VerticalAlignment="Top"/>

        <!-- 右下角未注册 -->
        <TextBlock x:Name="stateText" Text="未注册" FontSize="14" HorizontalAlignment="Right" Margin="0,0,40,20" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="tips" FontSize="16" HorizontalAlignment="Left" Margin="119,140,0,0" VerticalAlignment="Top" Width="326" Text="输入密码以进入教师模式。"/>
        <TextBlock x:Name="error" FontSize="16" HorizontalAlignment="Left" Margin="545,190,0,0" VerticalAlignment="Top" Width="134"><Run Language="zh-cn" Text="密码错误。"/></TextBlock>
    </Grid>
</Window>
